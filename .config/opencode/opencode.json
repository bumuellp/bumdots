        },
        "nemotron-3-super:latest": {
          "name": "Nemotron 3 Super"
        },
        "mixtral:8x22b": {
          "name": "Mixtral 8x22B"
        },
        "32k-llama3.3:latest": {
          "name": "Llama 3.3 (32k)",
          "limit": { "context": 32768, "output": 4096 }
        },
        "glm-4.7-flash:q8_0": {
          "name": "GLM 4.7 Flash"
        },
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B"
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B"
        },
        "deepseek-r1:14b": {
          "name": "DeepSeek R1 14B"
        },
        "deepseek-r1:7b": {
          "name": "DeepSeek R1 7B"
        },
        "llama3.2:latest": {
          "name": "Llama 3.2"
        },
        "glm-ocr:latest": {
          "name": "GLM OCR"
        }
      }
    }
  },
  "model": "ollama/qwen3-coder-next-256k:latest"
